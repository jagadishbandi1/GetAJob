# Required — Neon Postgres connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Required for resume parsing + autofiller (local use only — blocked on Vercel demo)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Gmail sync (local use only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — OAuth redirect base (defaults to http://localhost:4000)
NEXT_PUBLIC_BASE_URL=http://localhost:4000

# Set automatically on Vercel — enables read-only demo mode (no real data, no API spend)
# VERCEL=1
